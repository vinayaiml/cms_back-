// Prisma schema for Whizrobot CMS (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LicenseStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  REVOKED
}

enum ContentType {
  VIDEO
  IMAGE
  TEXT
}

enum LessonVisibility {
  PRIVATE
  PUBLIC_PREVIEW
}

enum CourseVisibility {
  PRIVATE
  PUBLIC
}

enum CourseSource {
  PLATFORM
  ORGANIZATION
}

enum CourseAccessType {
  FULL_COURSE
  LEVEL_ONLY
  CHAPTER_ONLY
}

enum DashboardTemplateType {
  NONE
  WIDGETS
  KPI_OVERVIEW
  MARKDOWN
}

model Organization {
  id                    Int      @id @default(autoincrement())
  name                  String
  state                 String
  city                  String
  authorizedPersonName  String
  contactNo             String
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  users       User[]
  robots      Robot[]
  courses     Course[] @relation("OrgOwnedCourses")
  assignments OrgCourseAccess[]
  notifications Notification[]
  events      Event[]
  roles       Role[]
  permissions OrgPermission[]
  usageLogs   RobotUsageLog[]
}

model User {
  id          Int      @id @default(autoincrement())
  orgId       Int?
  org         Organization? @relation(fields: [orgId], references: [id])
  createdByUserId Int?
  createdBy   User? @relation("UserCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdUsers User[] @relation("UserCreator")

  email       String   @unique
  fullName    String
  passwordHash String
  isSuperAdmin Boolean @default(false)
  isLocked    Boolean @default(false)

  roles       UserRole[]
  directPermissions UserPermission[]
  notifications Notification[] @relation("UserNotifications")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdByUserId])
}

model Role {
  id          Int      @id @default(autoincrement())
  orgId       Int?
  org         Organization? @relation(fields: [orgId], references: [id])

  name        String
  description String?

  permissions RolePermission[]
  users       UserRole[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([orgId, name])
}

model Permission {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  description String?
  category    String?

  roles       RolePermission[]
  users       UserPermission[]
  orgs        OrgPermission[]
}

model OrgPermission {
  id           Int @id @default(autoincrement())
  orgId        Int
  permissionId Int

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  permission Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([orgId, permissionId])
  @@index([orgId])
}

model RolePermission {
  id           Int @id @default(autoincrement())
  roleId       Int
  permissionId Int

  role         Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id      Int @id @default(autoincrement())
  userId  Int
  roleId  Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model UserPermission {
  id           Int @id @default(autoincrement())
  userId       Int
  permissionId Int

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model Robot {
  id            Int      @id @default(autoincrement())
  orgId         Int
  org           Organization @relation(fields: [orgId], references: [id])

  // Physical unique identifier
  serialNumber  String   @unique

  name          String?

  // License
  licenseKey    String   @unique
  validFrom     DateTime
  validUntil    DateTime
  licenseStatus LicenseStatus @default(ACTIVE)
  revokedAt     DateTime?

  // Auth / device metadata
  lastSeenAt    DateTime?
  appVersion    String?
  deviceModel   String?

  usageLogs     RobotUsageLog[]
  events        Event[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([orgId])
}

model Course {
  id            Int      @id @default(autoincrement())
  courseCode    String   @unique
  courseName    String
  description   String?
  courseImageUrl String?
  logoUrl       String?

  // Source and ownership
  source        CourseSource @default(PLATFORM)
  ownerOrgId    Int?
  ownerOrg      Organization? @relation("OrgOwnedCourses", fields: [ownerOrgId], references: [id])

  visibility    CourseVisibility @default(PRIVATE)

  // Public catalog control: expose ONLY this level publicly (Intro Level)
  introLevelId  Int?    @unique
  introLevel    Level?  @relation("IntroLevel", fields: [introLevelId], references: [id])

  levels        Level[]
  assignments   OrgCourseAccess[]
  events        Event[]
  lessons       Lesson[]
  usageLogs     RobotUsageLog[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([ownerOrgId])
}

model Level {
  id          Int      @id @default(autoincrement())
  courseId    Int
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  name        String
  sequence    Int
  description String?

  // Used for intro catalog referencing
  introForCourse Course? @relation("IntroLevel")

  chapters    Chapter[]
  lessons     Lesson[] @relation("LevelLessons")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([courseId, sequence])
}

model Chapter {
  id          Int      @id @default(autoincrement())
  levelId     Int
  level       Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)

  name        String
  sequence    Int
  description String?

  lessons     Lesson[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([levelId, sequence])
}

model Lesson {
  id            Int      @id @default(autoincrement())
  courseId      Int
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  levelId       Int
  level         Level    @relation("LevelLessons", fields: [levelId], references: [id], onDelete: Cascade)

  chapterId     Int?
  chapter       Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  name          String
  sequence      Int
  description   String?
  durationMins  Int?

  contentType   ContentType @default(VIDEO)
  contentUrl    String
  thumbnailUrl  String?
  logoUrl       String?

  visibility    LessonVisibility @default(PRIVATE)

  usageLogs     RobotUsageLog[]
  events        Event[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([courseId, levelId])
  @@unique([courseId, levelId, sequence])
}

model OrgCourseAccess {
  id         Int      @id @default(autoincrement())
  orgId      Int
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  courseId   Int
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  accessType CourseAccessType @default(FULL_COURSE)
  levelId    Int?
  chapterId  Int?

  createdAt  DateTime @default(now())

  @@index([orgId])
  @@unique([orgId, courseId, accessType, levelId, chapterId])
}

model RobotUsageLog {
  id          Int      @id @default(autoincrement())
  orgId       Int
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  robotId     Int
  robot       Robot    @relation(fields: [robotId], references: [id], onDelete: Cascade)

  courseId    Int?
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  lessonId    Int?
  lesson      Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  // Deduplication key from robot (UUID)
  eventId     String

  openedAt    DateTime
  durationSec Int?

  createdAt   DateTime @default(now())

  @@unique([robotId, eventId])
  @@index([orgId, robotId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  orgId     Int?
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  userId    Int?
  user      User? @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  type      String
  title     String
  message   String
  payload   Json?

  createdAt DateTime @default(now())
  readAt    DateTime?

  @@index([orgId, userId])
}

model DashboardSection {
  id                 Int      @id @default(autoincrement())
  key                String   @unique
  label              String
  path               String
  icon               String?
  sortOrder          Int      @default(0)
  requiredPermission String?
  isSuperAdminOnly   Boolean  @default(false)
  isActive           Boolean  @default(true)

  // Template-driven dashboards (so new sections can be created without code)
  templateType       DashboardTemplateType @default(NONE)
  templateConfig     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id        Int      @id @default(autoincrement())
  orgId     Int?
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  robotId   Int?
  robot     Robot? @relation(fields: [robotId], references: [id], onDelete: SetNull)

  courseId  Int?
  course    Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  lessonId  Int?
  lesson    Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  type      String
  payload   Json?

  createdAt DateTime @default(now())

  @@index([orgId, type])
}


model GlobalCounter {
  key   String @id
  value Int    @default(0)
}

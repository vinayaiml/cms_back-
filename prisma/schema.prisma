generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                   Int                              @id @default(autoincrement())
  name                 String
  state                String
  city                 String
  authorizedPersonName String
  contactNo            String
  isActive             Boolean                          @default(true)
  createdAt            DateTime                         @default(now())
  updatedAt            DateTime                         @updatedAt
  logoUrl              String?
  primaryColor         String?
  secondaryColor       String?
  tenantVersion        Int                              @default(1)
  courses              Course[]                         @relation("OrgOwnedCourses")
  events               Event[]
  notifications        Notification[]
  assignments          OrgCourseAccess[]
  permissions          OrgPermission[]
  robots               Robot[]
  subscriptions        OrganizationSubscription[]
  capabilityOverrides  OrganizationCapabilityOverride[]
  usageLogs            RobotUsageLog[]
  roles                Role[]
  users                User[]
}

model User {
  id                    Int                        @id @default(autoincrement())
  orgId                 Int?
  createdByUserId       Int?
  email                 String                     @unique
  fullName              String
  passwordHash          String
  isSuperAdmin          Boolean                    @default(false)
  isLocked              Boolean                    @default(false)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  notifications         Notification[]             @relation("UserNotifications")
  createdBy             User?                      @relation("UserCreator", fields: [createdByUserId], references: [id])
  createdUsers          User[]                     @relation("UserCreator")
  org                   Organization?              @relation(fields: [orgId], references: [id])
  courseAssignments     UserCourseAccess[]
  directPermissions     UserPermission[]
  capabilityAssignments UserCapabilityAssignment[]
  roles                 UserRole[]

  @@index([createdByUserId])
}

model Role {
  id          Int              @id @default(autoincrement())
  orgId       Int?
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  org         Organization?    @relation(fields: [orgId], references: [id])
  permissions RolePermission[]
  users       UserRole[]

  @@unique([orgId, name])
}

model Permission {
  id          Int              @id @default(autoincrement())
  key         String           @unique
  description String?
  category    String?
  orgs        OrgPermission[]
  roles       RolePermission[]
  users       UserPermission[]
}

model OrgPermission {
  id           Int          @id @default(autoincrement())
  orgId        Int
  permissionId Int
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([orgId, permissionId])
  @@index([orgId])
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id     Int  @id @default(autoincrement())
  userId Int
  roleId Int
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model UserPermission {
  id           Int        @id @default(autoincrement())
  userId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model Robot {
  id                    Int                         @id @default(autoincrement())
  orgId                 Int
  serialNumber          String                      @unique
  name                  String?
  licenseKey            String?                     @unique
  validFrom             DateTime
  validUntil            DateTime
  licenseStatus         LicenseStatus               @default(ACTIVE)
  revokedAt             DateTime?
  lastSeenAt            DateTime?
  appVersion            String?
  deviceModel           String?
  hardwareModel         String?
  hardwareProfile       Json?
  hardwareCapabilities  Json?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  deviceMetadata        Json?
  licenseKeyCiphertext  String?
  licenseKeyFingerprint String?                     @unique
  events                Event[]
  org                   Organization                @relation(fields: [orgId], references: [id])
  courseAssignments     RobotCourseAccess[]
  usageLogs             RobotUsageLog[]
  capabilityAssignments RobotCapabilityAssignment[]

  @@index([orgId])
}

model Capability {
  id               Int                              @id @default(autoincrement())
  stableKey        String                           @unique
  name             String
  description      String?
  category         String?
  version          Int
  requiredHardware Json?
  isActive         Boolean                          @default(true)
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt
  plans            PlanCapability[]
  orgOverrides     OrganizationCapabilityOverride[]
  robotAssignments RobotCapabilityAssignment[]
  userAssignments  UserCapabilityAssignment[]
}

model SubscriptionPlan {
  id               Int                        @id @default(autoincrement())
  stableKey        String                     @unique
  name             String
  description      String?
  version          Int
  isActive         Boolean                    @default(true)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  capabilities     PlanCapability[]
  orgSubscriptions OrganizationSubscription[]
}

model UserCapabilityAssignment {
  id              Int        @id @default(autoincrement())
  userId          Int
  capabilityId    Int
  isEnabled       Boolean    @default(true)
  limits          Json?
  createdByUserId Int?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  capability      Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([userId, capabilityId])
  @@index([capabilityId])
}

model RobotCapabilityAssignment {
  id              Int        @id @default(autoincrement())
  robotId         Int
  capabilityId    Int
  isEnabled       Boolean    @default(true)
  limits          Json?
  createdByUserId Int?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  robot           Robot      @relation(fields: [robotId], references: [id], onDelete: Cascade)
  capability      Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([robotId, capabilityId])
  @@index([capabilityId])
}

model OrganizationCapabilityOverride {
  id              Int                      @id @default(autoincrement())
  orgId           Int
  capabilityId    Int
  effect          CapabilityOverrideEffect
  reason          String
  createdByUserId Int?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  org             Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  capability      Capability               @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([orgId, capabilityId])
  @@index([capabilityId])
}

enum CapabilityOverrideEffect {
  ALLOW
  DENY
}

model OrganizationSubscription {
  id         Int                @id @default(autoincrement())
  orgId      Int
  planId     Int
  status     SubscriptionStatus @default(ACTIVE)
  validFrom  DateTime
  validUntil DateTime
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  org        Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan       SubscriptionPlan   @relation(fields: [planId], references: [id])

  @@index([orgId])
  @@index([planId])
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
}

model PlanCapability {
  planId       Int
  capabilityId Int
  createdAt    DateTime         @default(now())
  capability   Capability       @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, capabilityId])
  @@index([capabilityId])
}

model Course {
  id             Int               @id @default(autoincrement())
  courseCode     String            @unique
  courseName     String
  description    String?
  courseImageUrl String?
  logoUrl        String?
  source         CourseSource      @default(PLATFORM)
  ownerOrgId     Int?
  visibility     CourseVisibility  @default(PRIVATE)
  isPublished    Boolean           @default(true)
  introLevelId   Int?              @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  introLevel     Level?            @relation("IntroLevel", fields: [introLevelId], references: [id])
  ownerOrg       Organization?     @relation("OrgOwnedCourses", fields: [ownerOrgId], references: [id])
  events         Event[]
  lessons        Lesson[]
  levels         Level[]
  assignments    OrgCourseAccess[]
  robotAccess    RobotCourseAccess[]
  userAccess     UserCourseAccess[]
  usageLogs      RobotUsageLog[]

  @@index([ownerOrgId])
}

model Level {
  id             Int       @id @default(autoincrement())
  courseId       Int
  name           String
  sequence       Int
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  chapters       Chapter[]
  introForCourse Course?   @relation("IntroLevel")
  lessons        Lesson[]  @relation("LevelLessons")
  course         Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, sequence])
}

model Chapter {
  id          Int      @id @default(autoincrement())
  levelId     Int
  name        String
  sequence    Int
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  level       Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@unique([levelId, sequence])
}

model Lesson {
  id           Int              @id @default(autoincrement())
  courseId     Int
  levelId      Int
  chapterId    Int?
  name         String
  sequence     Int
  description  String?
  durationMins Int?
  contentType  ContentType      @default(VIDEO)
  contentUrl       String
  contentVersion   Int              @default(1)
  contentSizeBytes Int?
  contentChecksum  String?
  thumbnailUrl     String?
  logoUrl          String?
  visibility       LessonVisibility @default(PRIVATE)
  isPublished      Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  events           Event[]
  chapter          Chapter?         @relation(fields: [chapterId], references: [id])
  course           Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  level            Level            @relation("LevelLessons", fields: [levelId], references: [id], onDelete: Cascade)
  usageLogs        RobotUsageLog[]

  @@unique([courseId, levelId, sequence])
  @@index([courseId, levelId])
}

model OrgCourseAccess {
  id         Int              @id @default(autoincrement())
  orgId      Int
  courseId   Int
  accessType CourseAccessType @default(FULL_COURSE)
  levelId    Int?
  chapterId  Int?
  createdAt  DateTime         @default(now())
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  org        Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, courseId, accessType, levelId, chapterId])
  @@index([orgId])
}

model RobotCourseAccess {
  id         Int              @id @default(autoincrement())
  robotId    Int
  courseId   Int
  accessType CourseAccessType @default(FULL_COURSE)
  levelId    Int?
  chapterId  Int?
  isEnabled  Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  robot      Robot            @relation(fields: [robotId], references: [id], onDelete: Cascade)

  @@unique([robotId, courseId, accessType, levelId, chapterId])
  @@index([robotId])
  @@index([courseId])
}

model UserCourseAccess {
  id         Int              @id @default(autoincrement())
  userId     Int
  courseId   Int
  accessType CourseAccessType @default(FULL_COURSE)
  levelId    Int?
  chapterId  Int?
  isEnabled  Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, accessType, levelId, chapterId])
  @@index([userId])
  @@index([courseId])
}

model RobotUsageLog {
  id          Int          @id @default(autoincrement())
  orgId       Int
  robotId     Int
  courseId    Int?
  lessonId    Int?
  eventId     String
  openedAt    DateTime
  durationSec Int?
  createdAt   DateTime     @default(now())
  course      Course?      @relation(fields: [courseId], references: [id])
  lesson      Lesson?      @relation(fields: [lessonId], references: [id])
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  robot       Robot        @relation(fields: [robotId], references: [id], onDelete: Cascade)

  @@unique([robotId, eventId])
  @@index([orgId, robotId])
}

model Notification {
  id        Int           @id @default(autoincrement())
  orgId     Int?
  userId    Int?
  type      String
  title     String
  message   String
  payload   Json?
  createdAt DateTime      @default(now())
  readAt    DateTime?
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User?         @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, type, message])
  @@index([orgId, userId])
}

model DashboardSection {
  id                 Int                   @id @default(autoincrement())
  key                String                @unique
  label              String
  path               String
  icon               String?
  sortOrder          Int                   @default(0)
  requiredPermission String?
  isSuperAdminOnly   Boolean               @default(false)
  isActive           Boolean               @default(true)
  templateType       DashboardTemplateType @default(NONE)
  templateConfig     Json?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
}

model Event {
  id        Int           @id @default(autoincrement())
  orgId     Int?
  robotId   Int?
  courseId  Int?
  lessonId  Int?
  type      String
  payload   Json?
  createdAt DateTime      @default(now())
  course    Course?       @relation(fields: [courseId], references: [id])
  lesson    Lesson?       @relation(fields: [lessonId], references: [id])
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  robot     Robot?        @relation(fields: [robotId], references: [id])

  @@index([orgId, type])
}

model AuditEvent {
  id            Int      @id @default(autoincrement())
  actorUserId   Int?
  actorOrgId    Int?
  action        String
  targetType    String
  targetId      String
  targetOrgId   Int?
  correlationId String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([targetOrgId, createdAt])
  @@index([action, createdAt])
  @@index([correlationId])
}

model GlobalCounter {
  key   String @id
  value Int    @default(0)
}

enum LicenseStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  REVOKED
}

enum ContentType {
  VIDEO
  IMAGE
  TEXT
}

enum LessonVisibility {
  PRIVATE
  PUBLIC_PREVIEW
}

enum CourseVisibility {
  PRIVATE
  PUBLIC
}

enum CourseSource {
  PLATFORM
  ORGANIZATION
}

enum CourseAccessType {
  FULL_COURSE
  LEVEL_ONLY
  CHAPTER_ONLY
}

enum DashboardTemplateType {
  NONE
  WIDGETS
  KPI_OVERVIEW
  MARKDOWN
}

DATABASE_URL="postgresql://postgres:local_dev_postgres_pass@localhost:5433/whizrobot?schema=public"
# Optional seed-only direct database URL. Use Neon direct host here when DATABASE_URL uses a pooled host.
DIRECT_DATABASE_URL=""
JWT_SECRET="local-dev-jwt-secret-use-a-strong-value"
JWT_EXPIRES_IN="7d"
ROBOT_ACCESS_TOKEN_EXPIRES_IN="15m"
ROBOT_REFRESH_TOKEN_EXPIRES_IN="7d"
LICENSE_SECRET_KEY="local-dev-license-secret-minimum-32-characters"
PORT=3001
REDIS_ENABLED=false
REDIS_URL="redis://localhost:6379"
CORS_ALLOWED_ORIGINS="http://localhost:3000"
SUPER_ADMIN_PASSWORD="local-dev-super-admin-pass"
DEMO_ADMIN_PASSWORD="local-dev-demo-admin-pass"
TEST_USER_PASSWORD="local-dev-test-user-pass"

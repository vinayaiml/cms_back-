DATABASE_URL="postgresql://postgres:local_dev_postgres_pass@localhost:5433/whizrobot?schema=public"
# Optional seed-only direct database URL. Use Neon direct host here when DATABASE_URL uses a pooled host.
DIRECT_DATABASE_URL=""
JWT_SECRET="local-dev-jwt-secret-use-a-strong-value"
JWT_EXPIRES_IN="7d"
ROBOT_ACCESS_TOKEN_EXPIRES_IN="15m"
ROBOT_REFRESH_TOKEN_EXPIRES_IN="7d"
LICENSE_SECRET_KEY="local-dev-license-secret-minimum-32-characters"
PORT=3001
REDIS_ENABLED=false
REDIS_URL="redis://localhost:6379"
JOBS_TRIGGER_SECRET="replace-with-long-random-job-secret"
CORS_ALLOWED_ORIGINS="http://localhost:3000"
SUPER_ADMIN_PASSWORD="local-dev-super-admin-pass"
DEMO_ADMIN_PASSWORD="local-dev-demo-admin-pass"
TEST_USER_PASSWORD="local-dev-test-user-pass"

# Optional backend-only AI provider gateway settings. Do not expose these to frontend or Android.
AI_PROVIDER_BASE_URL=""
AI_PROVIDER_API_KEY=""
AI_PROVIDER_MODEL=""
AI_PROVIDER_ALIAS="cms-ai-provider"
AI_PROVIDER_MODEL_ALIAS="default-conversation-model"
AI_PROVIDER_POLICY_VERSION="ai-provider-policy-v1"
AI_PROVIDER_TIMEOUT_MS=8000
AI_PROVIDER_FIRST_TOKEN_TIMEOUT_MS=5000
AI_PROVIDER_MAX_RETRIES=1
AI_PROVIDER_MAX_INPUT_CHARS=4000
AI_PROVIDER_MAX_OUTPUT_TOKENS=200
AI_PROVIDER_MAX_ESTIMATED_COST_MICRO_USD=1000
AI_PROVIDER_INPUT_COST_MICRO_USD_PER_1K_TOKENS=0
AI_PROVIDER_OUTPUT_COST_MICRO_USD_PER_1K_TOKENS=0
IDENTITY_RETENTION_DAYS=365
